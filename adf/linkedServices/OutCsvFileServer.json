{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": {
      "type": "string",
      "metadata": "Data Factory name",
      "defaultValue": "az-ins-df"
    },
    "OutCsvFileServer_connectionString": {
      "type": "string",
      "metadata": "Path to the folder that contains out.csv on the Self-hosted Integration Runtime host",
      "defaultValue": "C:\\data\\triage"
    }
  },
  "variables": {
    "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
  },
  "resources": [
    {
      "name": "[concat(parameters('factoryName'), '/OutCsvFileServer')]",
      "type": "Microsoft.DataFactory/factories/linkedServices",
      "apiVersion": "2018-06-01",
      "properties": {
        "annotations": [],
        "type": "FileServer",
        "typeProperties": {
          "host": "[parameters('OutCsvFileServer_connectionString')]"
        },
        "connectVia": {
          "referenceName": "default",
          "type": "IntegrationRuntimeReference"
        }
      }
    }
  ]
}

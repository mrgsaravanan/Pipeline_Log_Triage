{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "factoryName": {
      "type": "string",
      "defaultValue": "az-ins-df"
    },
    "targetTableName": {
      "type": "string",
      "defaultValue": "out_csv_data"
    }
  },
  "resources": [
    {
      "name": "[concat(parameters('factoryName'), '/OutCsvDataTable')]",
      "type": "Microsoft.DataFactory/factories/datasets",
      "apiVersion": "2018-06-01",
      "properties": {
        "linkedServiceName": {
          "referenceName": "NeonPostgres",
          "type": "LinkedServiceReference"
        },
        "annotations": [],
        "type": "AzurePostgreSqlTable",
        "typeProperties": {
          "tableName": "[parameters('targetTableName')]"
        }
      }
    }
  ]
}
